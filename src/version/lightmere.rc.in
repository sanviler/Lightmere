// Generated by CMake from src/version/lightmere.rc.in: version information of the Windows executable
#include <winver.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Lightmere - a port of the Amiga game Darkmere"
            VALUE "FileVersion", "@LM_VERSION_SHORT@"
            VALUE "CompanyName", "Lorenzo Castelletta"
            VALUE "ProductName", "Lightmere"
            VALUE "ProductVersion", "@LM_VERSION_SHORT@"
            VALUE "InternalName", "lightmere"
            VALUE "OriginalFilename", "lightmere.exe"
            VALUE "LegalCopyright", "(c) Lorenzo Castelletta, GPL-3.0-or-later. Made largely with AI. Darkmere is (c) Core Design; no part of the original game is included."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
